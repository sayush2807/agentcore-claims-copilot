{
  "name": "ClaimsCopilot",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "agent",
      "modelProvider": "Bedrock",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/agent",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "agentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "LegacySystems",
      "protocolType": "MCP",
      "description": "Read-only front door to the insurer's policy administration and core claims systems, for the agent",
      "targets": [
        {
          "name": "legacy-api",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "get_claim",
              "description": "Look up a claim in the core claims system by its ID, for example CLM-9000.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "claim_id": {
                    "type": "string",
                    "description": "Claim ID, for example CLM-9000"
                  }
                },
                "required": [
                  "claim_id"
                ]
              }
            },
            {
              "name": "get_policy",
              "description": "Look up a policy in the policy administration system by its ID, for example POL-1000. Returns status, policy period, coverages with limits and deductibles, and exclusions.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "policy_id": {
                    "type": "string",
                    "description": "Policy ID, for example POL-1000"
                  }
                },
                "required": [
                  "policy_id"
                ]
              }
            },
            {
              "name": "list_claims_for_policy",
              "description": "List every claim filed against a policy, oldest first.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "policy_id": {
                    "type": "string",
                    "description": "Policy ID, for example POL-1000"
                  }
                },
                "required": [
                  "policy_id"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "services/legacy_api",
              "handler": "handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 15,
            "memorySize": 256
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "ClaimsGuardrails",
        "mode": "ENFORCE"
      }
    },
    {
      "name": "AdjusterActions",
      "protocolType": "MCP",
      "description": "Actions taken by human approvers through the adjuster application. Requires a signed-in user.",
      "targets": [
        {
          "name": "claims-actions",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "approve_payout",
              "description": "Record a human approver's decision to pay a claim. The caller's role and the amount are checked by Gateway policy.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "claim_id": {
                    "type": "string",
                    "description": "Claim ID, for example CLM-9000"
                  },
                  "amount": {
                    "type": "integer",
                    "description": "Approved payout in whole currency units"
                  }
                },
                "required": [
                  "claim_id",
                  "amount"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "services/legacy_api",
              "handler": "handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 15,
            "memorySize": 256
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-2.amazonaws.com/POOL_ID_SET_AT_DEPLOY/.well-known/openid-configuration",
          "allowedAudience": [
            "CLIENT_ID_SET_AT_DEPLOY"
          ]
        }
      },
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "ClaimsGuardrails",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "ClaimsGuardrails",
      "description": "Hard limits on claims actions, enforced at the Gateway outside the agent",
      "policies": []
    }
  ],
  "configBundles": [],
  "harnesses": []
}
